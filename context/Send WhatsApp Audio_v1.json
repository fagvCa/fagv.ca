{
  "name": "Send WhatsApp Audio",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// In a Code node after receiving the audio\nfor (const item of $input.all()) {\n  // Check if data field exists and has binary data\n  if (item.binary?.data) {\n    // Create a proper filename with timestamp\n    const timestamp = Date.now();\n    const filename = `audio_${timestamp}.opus`;\n    \n    // If the binary data doesn't have a proper filename\n    if (!item.binary.data.fileName || !item.binary.data.fileName.endsWith('.opus')) {\n      item.binary.data.fileName = filename;\n      item.binary.data.mimeType = 'audio/opus';\n    }\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        32
      ],
      "id": "2f57a250-5b1a-42b0-ad12-42e97eaa62b4",
      "name": "Audio File Properties"
    },
