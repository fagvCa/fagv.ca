    {
      "parameters": {
        "jsCode": "// Input language code from previous node\nconst lang = $input.first().json.lang || \"en\";\n\n// ## Voice for each language\n\n// JddqVF50ZSIR7SRbJE6u | Valeria - Friendly Woman  | 2y  | Spanish | ****\n// 3Fx71T889APcHRu4VtQf | Medellin - Colombian voiceId | 0d  | Spanish | ****\n// g6xIsTj2HwM6VR4iXFCw | Jessica Anne Bogart - Chatty and Friendly | 2y  | hi, ar, fr, 13+ | ****\n// VmejBeYhbrcTPwDniox7 | Lina - Carefree & Fresh | 2y  | es  | *****\n// HjAbwkwspyYo9MhDWD5x | Celeste | 2y  | en| ***\n\nconst voiceIds = {\n  en: `g6xIsTj2HwM6VR4iXFCw`,   // Jessica Anne Bogart\n  hi: `g6xIsTj2HwM6VR4iXFCw`,   // Jessica Anne Bogart\n  ar: `g6xIsTj2HwM6VR4iXFCw`,   // Jessica Anne Bogart\n  fr: `g6xIsTj2HwM6VR4iXFCw`,   // Jessica Anne Bogart\n  es: `VmejBeYhbrcTPwDniox7`,   // Lina - Carefree & Fresh\n}\n// Determine the message to output\n\n$input.first().json.voiceId = voiceIds[lang] || voiceIds.en\n$input.first().json.lang = lang\n\n// Return as n8n output\nreturn $input.first();\n"
      },
